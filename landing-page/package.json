{
  "name": "placewise-landing-page",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:studio": "vite --config vite.studio.config.ts --host 127.0.0.1 --port 5176",
    "build:studio": "node scripts/build-studio.mjs",
    "design-system:generate": "node scripts/design-system.mjs",
    "design-system:check": "node scripts/design-system.mjs --check && node scripts/design-system-artifacts.mjs --check",
    "design-system:docs": "node scripts/build-studio.mjs",
    "design-system:export": "node scripts/export-design-tokens.mjs",
    "dev:foundation": "vite --config vite.foundation.config.ts --host 127.0.0.1 --port 5178",
    "build:foundation": "tsc --noEmit && vite build --config vite.foundation.config.ts"
  },
  "dependencies": {
    "@ionic/core": "9.0.4",
    "@ionic/react": "9.0.4",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ionicons": "8.1.0",
    "lucide-react": "^0.468.0",
    "mapbox-gl": "^3.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
