  "groups": [
    {
      "id": "surfaces",
      "label": "Surfaces & text",
      "description": "White reading surfaces by day; cool, elevated surfaces at night.",
      "tokens": [
        "--background",
        "--foreground",
        "--card",
        "--card-foreground",
        "--popover",
        "--popover-foreground",
        "--muted",
        "--muted-foreground",
        "--text-brand",
        "--background-inverse",
        "--foreground-inverse"
      ]
    },
    {
      "id": "actions",
      "label": "Actions & selection",
      "description": "Explicit hover, active and disabled roles.",
      "tokens": [
        "--primary",
        "--primary-hover",
        "--primary-active",
        "--primary-foreground",
        "--secondary",
        "--secondary-hover",
        "--secondary-active",
        "--secondary-foreground",
        "--accent",
        "--accent-foreground",
        "--disabled",
        "--disabled-foreground"
      ]
    },
    {
      "id": "structure",
      "label": "Borders & brand details",
      "description": "Quiet dividers, stronger control boundaries and restrained peach.",
      "tokens": [
        "--border",
        "--border-strong",
        "--input",
        "--ring",
        "--brand-accent",
        "--brand-accent-foreground"
      ]
    },
    {
      "id": "feedback",
      "label": "Feedback",
      "description": "Pair each surface with its foreground and a readable label.",
      "tokens": [
        "--destructive",
        "--destructive-hover",
        "--destructive-foreground",
        "--danger-subtle",
        "--danger-subtle-foreground",
        "--success",
        "--success-foreground",
        "--warning",
        "--warning-foreground",
